# Datenbank (Hetzner Managed Postgres in Production)
DATABASE_URL=postgresql://postgres:itmart_dev_pw@localhost:5433/itmart_dev

# Auth.js
AUTH_SECRET=change-me-min-32-chars-please-use-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
ALLOW_DEV_IMPERSONATION=false
DEV_ADMIN_PASSWORD=change-me-for-local-development

# E-Mail (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@itmart.example.com

# Background-Jobs
ENABLE_CRON=false
